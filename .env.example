# ============================================================
# KARKI TILES DIGITAL SHOWROOM — ENVIRONMENT VARIABLES
# ============================================================

# ---- DATABASE (Neon PostgreSQL) -------------------------------
# On Vercel (Production & Preview):
#   Set automatically when you connect the Neon integration.
#
# Locally:
#   Set this to your Neon project's connection string.
#   Example: postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=replace-with-your-database-url

# ---- STORAGE (Vercel Blob) ------------------------------------
# On Vercel (Production & Preview):
#   Set automatically when you connect the Vercel Blob store.
#
# Locally:
#   Set this to the token from your Vercel Blob store settings.
BLOB_READ_WRITE_TOKEN=replace-with-your-blob-token

# ---- AUTHENTICATION -------------------------------------------
# SERVER-ONLY. Long random string used to sign JWT session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-32-plus-char-random-string

# ---- ADMIN CREDENTIALS ----------------------------------------
# SERVER-ONLY. Credentials for the showroom owner at /admin/login.
ADMIN_EMAIL=owner@karkitiles.com
ADMIN_PASSWORD=replace-with-a-strong-password
