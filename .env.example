# ============================================================
# KARKI TILES DIGITAL SHOWROOM — ENVIRONMENT VARIABLES
# ============================================================

# ---- DATABASE -------------------------------------------------
# On Netlify (production + deploy previews):
#   No configuration needed here.
#   Netlify Database automatically injects NETLIFY_DB_URL into every
#   function at runtime.  The app reads it via getConnectionString()
#   from @netlify/database.
#
# Locally WITH the Netlify CLI (`netlify dev`):
#   NETLIFY_DB_URL is injected automatically from the linked site.
#   No extra variable needed.
#
# Locally WITHOUT the Netlify CLI (`next dev` against local Postgres):
#   Uncomment and set DATABASE_URL below.
#   Example: postgres://postgres:password@localhost:5432/karkitiles
# DATABASE_URL=postgres://user:pass@localhost:5432/karkitiles

# ---- AUTHENTICATION -------------------------------------------
# SERVER-ONLY. Long random string used to sign JWT session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-32-plus-char-random-string

# ---- ADMIN CREDENTIALS ----------------------------------------
# SERVER-ONLY. Credentials for the showroom owner at /admin/login.
ADMIN_EMAIL=owner@karkitiles.com
ADMIN_PASSWORD=replace-with-a-strong-password
