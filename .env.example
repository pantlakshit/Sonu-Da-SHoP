# ============================================================
# BERINAG DIGITAL SHOWROOM OS — ENVIRONMENT VARIABLES
# ============================================================

# Supabase Project URL & Anon Public API Key (Required for live production database & auth)
# Found in: Supabase Project Settings > API > Project URL & anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Supabase Service Role Key (Server-side ONLY; NEVER prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
